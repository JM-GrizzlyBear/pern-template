{
  "name": "@pern/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "check-types": "tsc --noEmit && tsc -p tsconfig.test.json",
    "db:new": "dbmate new",
    "db:migrate": "dbmate --no-dump-schema migrate",
    "db:rollback": "dbmate --no-dump-schema rollback",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@pern/shared": "workspace:*",
    "bcryptjs": "3.0.3",
    "connect-pg-simple": "10.0.0",
    "dbmate": "2.36.0",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
